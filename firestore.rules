rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザー設定: 本人のみアクセス可
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 現場データ
    match /projects/{projectId} {
      // オーナーは読み書き可
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      // 旧形式の共有リンク用（shareToken が設定されていれば誰でも読める）
      // 新形式への移行が完了したら、この行は削除を検討してください
      allow read: if resource.data.shareToken != null;
    }

    // 共有トークン（新形式）
    // ドキュメントには projectId・ownerUid・createdAt のみ保存
    match /shares/{shareToken} {
      allow read: if true;                           // 誰でも読める（機密情報なし）
      allow create: if request.auth != null          // 認証ユーザーのみ作成可
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null          // オーナーのみ削除可
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
