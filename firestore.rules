rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 実行予算書アプリ（kawara-budget）用: 許可されたスタッフのUIDのみ
    function isStaff() {
      return request.auth != null && request.auth.uid in [
        "rN33HdI5AZdHauyRHDKkWI5FSvo1"
      ];
    }

    // ユーザー設定: 本人のみアクセス可
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 現場データ: オーナーのみ読み書き可
    match /projects/{projectId} {
      // 読み取り・更新・削除: 既存ドキュメントの userId と照合
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      // 作成: 書き込もうとしている userId と認証ユーザーを照合（なりすまし防止）
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // 実行予算書アプリ（kawara-budget）用コレクション
    match /cost_projects/{document=**} {
      allow read, write: if isStaff();
    }
    match /cost_master/{document=**} {
      allow read, write: if isStaff();
    }
    match /cost_system/{document=**} {
      allow read, write: if isStaff();
    }

  }
}
