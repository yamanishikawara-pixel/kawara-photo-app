rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── 写真・位置図・材料 ──────────────────────────────────────
    // 読み取り: ログイン済みユーザーのみ（社内専用）
    // 書き込み: ログイン済みユーザーのみ・サイズ制限あり
    // ※ firestore.get() による所有権チェックはアップロード失敗の原因になるため除外
    match /photos/{projectId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024;  // 15MB（圧縮失敗時の元ファイルを考慮）
    }

    match /maps/{projectId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024;
    }

    match /materials/{projectId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024;
    }

    // ── 添付PDF・ロゴ（uid スコープ）──────────────────────────
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── ロゴ: ファイル名が uid_ で始まる場合のみ本人が書き込み可 ──
    match /logos/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && file.matches(request.auth.uid + '_.*');
      allow delete: if request.auth != null
        && file.matches(request.auth.uid + '_.*');
    }

    // ── 材料マスタ画像: ファイル名が uid_ で始まる場合のみ本人が書き込み可 ──
    match /materialMaster/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && file.matches(request.auth.uid + '_.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null
        && file.matches(request.auth.uid + '_.*');
    }
  }
}
