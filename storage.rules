rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── 写真 ────────────────────────────────────────────────────
    // 読み取り: 誰でも可（共有リンクの <img> タグで使用するため）
    // 書き込み: ログインユーザーのみ（匿名ユーザーによる不正アップロードを防止）
    match /photos/{projectId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024;   // 5MB
    }

    // ── 位置図 ──────────────────────────────────────────────────
    match /maps/{projectId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024;  // 20MB
    }

    // ── 材料画像 ────────────────────────────────────────────────
    match /materials/{projectId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024;   // 5MB
    }

    // ── 添付PDF・ロゴ（uid スコープ）──────────────────────────
    // 本人のみアクセス可（他ユーザーからは読み取り不可）
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── ロゴ ────────────────────────────────────────────────────
    match /logos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
