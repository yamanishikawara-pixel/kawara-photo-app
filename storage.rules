rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── 写真 ────────────────────────────────────────────────────
    // 読み取り: 誰でも可（共有リンクの <img> タグで使用するため）
    // 書き込み: ログインユーザーのみ（匿名ユーザーによる不正アップロードを防止）
    // 写真・位置図・材料: 現場オーナーのみ読み書き可
    match /photos/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    // ── 位置図 ──────────────────────────────────────────────────
    match /maps/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    // ── 材料画像 ────────────────────────────────────────────────
    match /materials/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    // ── 添付PDF・ロゴ（uid スコープ）──────────────────────────
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── ロゴ: ファイル名が uid_ で始まる場合のみ本人が書き込み可 ──
    match /logos/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && file.matches(request.auth.uid + '_.*');
      allow delete: if request.auth != null
        && file.matches(request.auth.uid + '_.*');
    }
  }
}
